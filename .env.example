# ============================================================
# CONFIGURACIÓN DEL SISTEMA (.env.example)
# 
# Copia este archivo como '.env' en la raíz y completa los valores.
# El archivo '.env' real NUNCA debe subirse a Git.
# ============================================================

# ─────────────────────────────────────────────────────────────
# BASE DE DATOS (PostgreSQL)
# ─────────────────────────────────────────────────────────────
DB_NAME=solicitudesdb
DB_USER=postgres
DB_PASSWORD=tu_password_seguro_aqui
DB_PORT=5432

# ─────────────────────────────────────────────────────────────
# SEGURIDAD (JWT)
# ─────────────────────────────────────────────────────────────
# Secreto para firmar tokens JWT (mínimo 64 caracteres)
# Generar con: openssl rand -base64 64
JWT_SECRET=tu_jwt_secret_seguro_de_minimo_64_caracteres_aqui

# ─────────────────────────────────────────────────────────────
# INTELIGENCIA ARTIFICIAL (Google Gemini)
# ─────────────────────────────────────────────────────────────
# Obtener en: https://aistudio.google.com/
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ─────────────────────────────────────────────────────────────
# FRONTEND (Docker)
# ─────────────────────────────────────────────────────────────
FRONTEND_PORT=80
